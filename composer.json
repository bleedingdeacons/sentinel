{
    "name": "bleeding-deacons/sentinel",
    "description": "Status dashboard and shared logger for the Bleeding Deacons suite, and the server side of the Monitor app.",
    "type": "wordpress-plugin",
    "license": "MIT (Modified)",
    "authors": [
        {
            "name": "The Bleeding Deacons",
            "email": "thebleedingdeacons@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bleedingdeacons/guardian"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bleedingdeacons/wp-mocks"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "bleedingdeacons/guardian": "^1.0"
    },
    "require-dev": {
        "bleedingdeacons/wp-mocks": "^3.0",
        "mockery/mockery": "^1.4",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "psr/container": "^2.0",
        "squizlabs/php_codesniffer": "^4.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Sentinel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sentinel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "build": "php build.php build:production",
        "build:production": "php build.php build:production",
        "build:dev": "php build.php build:dev",
        "build:clean": "php build.php clean",
        "phpcs": "phpcs --standard=.phpcs.xml.dist",
        "phpcs:fix": "phpcbf --standard=.phpcs.xml.dist",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "pest"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
